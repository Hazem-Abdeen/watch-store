# Documentation only: Django does not auto-load this file.
# Store real values outside the checkout, readable only by the app user.
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_SECRET_KEY=
# Comma-separated hosts, no scheme/port. Replace the documentation IP.
DJANGO_ALLOWED_HOSTS=203.0.113.10,example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://203.0.113.10
DB_NAME=abdeen
DB_USER=abdeen
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60
DJANGO_STATIC_ROOT=/srv/abdeen/static
DJANGO_MEDIA_ROOT=/srv/abdeen/media
DJANGO_SEARCH_INDEX_PATH=/srv/abdeen/search
# Temporary HTTP/IP smoke testing only. Set true after configuring TLS in Nginx.
DJANGO_HTTPS_ENABLED=false
DJANGO_TRUST_PROXY_HEADERS=true
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
# Existing email variables remain supported. Configure SMTP before real orders.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=orders@example.com
SERVER_EMAIL=server@example.com
ABDEEN_ORDER_NOTIFICATION_EMAILS=
